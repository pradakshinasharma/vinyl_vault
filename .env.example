# Copy this file to ".env" and fill in your own values. Never push ".env" to GitHub.
# On the hosting platform, enter the same names and values in its Environment / Variables settings
# (no quotes, one line each).

# --- Database -----------------------------------------------------------------------------------
# NEW database (Neon): copy the connection string from the Neon dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- File storage: Cloudflare R2 (S3-compatible) -------------------------------------------------
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=album-covers
# The bucket's public address, from R2 -> your bucket -> Settings -> Public Development URL
S3_PUBLIC_BASE_URL=https://pub-XXXXXXXX.r2.dev
S3_REGION=auto

# --- Only needed while migrating (migrate.py); not needed on the hosting platform -------------
# OLD_DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# NEW_DATABASE_URL=the same value as DATABASE_URL above

# --- Old setup (Supabase storage), only if STORAGE_BACKEND=supabase -------------------------------
# SUPABASE_URL=https://PROJECTREF.supabase.co
# SUPABASE_KEY=
